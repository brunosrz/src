{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "package-name": "src",
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["version.txt"],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Novos estudos e recursos"
        },
        {
          "type": "fix",
          "section": "Correções"
        },
        {
          "type": "docs",
          "section": "Documentação"
        },
        {
          "type": "chore",
          "section": "Manutenção"
        },
        {
          "type": "ci",
          "section": "Integração contínua"
        },
        {
          "type": "test",
          "section": "Testes"
        },
        {
          "type": "refactor",
          "section": "Refatoração"
        }
      ]
    }
  }
}
